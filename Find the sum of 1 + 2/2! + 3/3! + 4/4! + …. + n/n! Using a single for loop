#include <stdio.h>

int main() {
    int n;
    float sum = 0.0;
    float factorial = 1.0;

 
    printf("Enter a positive integer n: ");
    scanf("%d", &n);

    
    for (int i = 1; i<= n; i++) {
        factorial *= i; 
        sum += i / factorial;
    }

   
    printf("The sum is: %f\n", sum);

    return 0;
}
